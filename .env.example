# Copy this file to .env for scripts/start_backend.ps1 or Docker Compose.
NOTETOGETHER_DB=backend/state/app.sqlite3
WEB_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# For personal Gmail, only fill SMTP_USERNAME and SMTP_PASSWORD.
# Keep SMTP_HOST/SMTP_FROM empty to use smtp.gmail.com and your Gmail address.
# To disable SMTP, leave host and both credentials empty. Never commit .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=3
# Optional custom trusted CA for local TLS tests; normal providers use system roots.
SMTP_CA_FILE=
# Private 32-byte mail PRF key; default is NOTETOGETHER_DB + .mail-key.
# Auto-created on first configured send; keep it with server state, never in Git.
MAIL_OUTBOX_KEY_FILE=
# Gemini is called only by the backend. Choose a Google AI Studio Free tier project.
# For local use, fill GEMINI_API_KEY in your ignored .env, then restart the backend.
# GEMINI_API_KEY_FILE is an optional alternative for mounted secrets.
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.1-flash-lite
