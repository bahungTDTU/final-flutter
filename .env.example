# Environment is read by the backend process. Copy values into your service configuration.
NOTETOGETHER_DB=backend/state/app.sqlite3
WEB_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# SMTP is consumed by backend/email_delivery.py. Empty host disables sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=3
# Optional custom trusted CA for local TLS tests; normal providers use system roots.
SMTP_CA_FILE=
# Private 32-byte mail PRF key; default is NOTETOGETHER_DB + .mail-key.
# Auto-created on first configured send; keep it with server state, never in Git.
MAIL_OUTBOX_KEY_FILE=
# Gemini is called only by the backend. Choose a Google AI Studio Free tier project.
# Use either GEMINI_API_KEY or GEMINI_API_KEY_FILE, never a Flutter dart-define.
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-2.5-flash-lite
